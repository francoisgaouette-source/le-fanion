// Cloudflare (fanion.ai) : le site web (dossier site/) et l'envoi de textos (/api/sms, worker.js).
// L'app Fanion Game reste sur GitHub Pages (app.lefanion.ai). Le Worker passe en premier pour rediriger les anciennes adresses fanion.ai.
{
  "name": "pelland",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  // Les branches autres que main passent par « wrangler preview », qui exige ce bloc (sinon la build échoue).
  "previews": {}
}
